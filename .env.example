# ==============================================================================
# TokMetrics AI - TikTok & Google Sheets API Environment Variables Configuration
# Copy this file to .env and fill in your actual credentials.
# Add these same keys into Vercel -> Project Settings -> Environment Variables.
# ==============================================================================

# TikTok Display & Business API Credentials
TIKTOK_ACCOUNT_USERNAME="@akhmad.suhardian"
TIKTOK_APP_CLIENT_KEY="your_tiktok_app_client_key_here"
TIKTOK_APP_CLIENT_SECRET="your_tiktok_app_client_secret_here"
TIKTOK_ACCESS_TOKEN="your_tiktok_oauth_bearer_access_token_here"

# Google Sheets API Credentials
GOOGLE_SHEETS_SPREADSHEET_ID="your_google_sheet_spreadsheet_id_here"
GOOGLE_SHEETS_API_KEY="your_google_cloud_api_key_here"
GOOGLE_SHEETS_TARGET_TAB="TikTok_Analytics_Report"
